{
  "openapi": "3.0.3",
  "info": {
    "title": "Finance App Service - Goals API",
    "version": "1.0.0",
    "description": "OpenAPI documentation for savings goals routes only."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "CreateGoalRequest": {
        "type": "object",
        "required": [
          "name",
          "target_amount"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "target_amount": {
            "type": "number",
            "format": "double"
          },
          "current_amount": {
            "type": "number",
            "format": "double",
            "default": 0
          }
        }
      },
      "UpdateGoalRequest": {
        "type": "object",
        "required": [
          "name",
          "target_amount"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "target_amount": {
            "type": "number",
            "format": "double"
          },
          "current_amount": {
            "type": "number",
            "format": "double",
            "default": 0
          }
        }
      },
      "GoalResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "target_amount": {
            "type": "number",
            "format": "double"
          },
          "current_amount": {
            "type": "number",
            "format": "double"
          },
          "is_completed": {
            "type": "boolean"
          }
        }
      },
      "GoalListResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalResponse"
            }
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "GenericMessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/api/goals": {
      "get": {
        "tags": [
          "Goals"
        ],
        "summary": "Get all savings goals",
        "description": "Retrieves all savings goals for the authenticated user.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Goals returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-negative-tests": [
          "Call without Authorization header returns 401.",
          "Call with invalid token returns 401."
        ]
      },
      "post": {
        "tags": [
          "Goals"
        ],
        "summary": "Create a savings goal",
        "description": "Creates a new savings goal for the authenticated user.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGoalRequest"
              },
              "example": {
                "name": "Liburan Bali",
                "target_amount": 5000000,
                "current_amount": 0
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Goal created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericMessageResponse"
                },
                "example": {
                  "message": "Goal created successfully",
                  "request_id": "req-123e4567-e89b-12d3-a456-426614174000"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-negative-tests": [
          "Send missing required fields returns 400.",
          "Call without auth returns 401."
        ]
      }
    },
    "/api/goals/{id}": {
      "put": {
        "tags": [
          "Goals"
        ],
        "summary": "Update a savings goal",
        "description": "Updates an existing savings goal for the authenticated user.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Goal ID"
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateGoalRequest"
              },
              "example": {
                "name": "Liburan Bali",
                "target_amount": 5000000,
                "current_amount": 2000000
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Goal updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericMessageResponse"
                },
                "example": {
                  "message": "Goal updated successfully",
                  "request_id": "req-123e4567-e89b-12d3-a456-426614174000"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or Goal ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-negative-tests": [
          "Call without auth returns 401.",
          "Call with invalid UUID returns 400.",
          "Send missing required fields returns 400."
        ]
      },
      "delete": {
        "tags": [
          "Goals"
        ],
        "summary": "Delete a savings goal",
        "description": "Deletes an existing savings goal for the authenticated user.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Goal ID"
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Goal deleted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenericMessageResponse"
                },
                "example": {
                  "message": "Goal deleted successfully",
                  "request_id": "req-123e4567-e89b-12d3-a456-426614174000"
                }
              }
            }
          },
          "400": {
            "description": "Invalid Goal ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-negative-tests": [
          "Call without auth returns 401.",
          "Call with invalid UUID returns 400."
        ]
      }
    }
  }
}
